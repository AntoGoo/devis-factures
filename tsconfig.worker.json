{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["./worker-configuration.d.ts", "vite/client", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "src/worker",
    "src/shared",
    "src/templates/types.ts",
    "src/templates/catalog.ts",
    "src/templates/*/v*/meta.ts",
    "test/worker"
  ]
}
